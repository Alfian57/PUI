COMPOSE_PROJECT_NAME=pui

WEB_PORT=5173
API_PORT=8080

VITE_API_BASE_URL=http://localhost:8080
VITE_ENVIRONMENT_NAME=environment-a

POSTGRES_DB=pui
POSTGRES_USER=pui
POSTGRES_PASSWORD=change_me

API_HTTP_ADDR=:8080
API_ALLOWED_ORIGIN=http://localhost:5173
API_DATABASE_URL=postgres://pui:change_me@postgres:5432/pui?sslmode=disable
VAULT_UDS_PATH=/var/run/pui/uds/vault-core.sock
VAULT_CHUNK_ROOT=/var/lib/pui/chunks
API_MIGRATIONS_PATH=/app/db/migrations
MAX_UPLOAD_SIZE_BYTES=536870912
RATE_LIMIT_PER_MINUTE=120
SESSION_TTL_MINUTES=1440

BADGER_PATH=/var/lib/pui/badger
CHUNK_ROOT=/var/lib/pui/chunks
FASTCDC_MIN_CHUNK_SIZE=65536
FASTCDC_AVG_CHUNK_SIZE=262144
FASTCDC_MAX_CHUNK_SIZE=1048576
UDS_OWNER_UID=10002
UDS_OWNER_GID=20000
UDS_ALLOWED_UIDS=10001
