# HashBox PUI - Docker Compose
# Internal identity, UDS, migration, storage, and ownership use config/Compose.

# Host endpoints (replace localhost for staging/production)
WEB_PORT=5173
API_PORT=8080
VITE_API_BASE_URL=http://localhost:8080
VITE_SECURITY_LAB_ENABLED=false

# PostgreSQL
POSTGRES_DB=pui
POSTGRES_USER=pui
POSTGRES_PASSWORD=change_me
# Format: postgres://username:password@host:port/database?sslmode=disable
# Compose host is postgres; standalone host is localhost.
API_DATABASE_URL=postgres://pui:change_me@postgres:5432/pui?sslmode=disable

# API and security
# Must match the frontend origin for this environment.
API_ALLOWED_ORIGIN=http://localhost:5173
TRUSTED_PROXIES=
MAX_UPLOAD_SIZE_BYTES=536870912
RATE_LIMIT_PER_MINUTE=120
SESSION_TTL_MINUTES=1440
SECURITY_LAB_ENABLED=false

# Password reset and SMTP
# Replace API_PUBLIC_WEB_URL for staging/production.
API_PUBLIC_WEB_URL=http://localhost:5173
API_PASSWORD_RESET_TTL_MINUTES=30
# SMTP is optional until password-reset email is enabled.
API_SMTP_HOST=
API_SMTP_PORT=587
API_SMTP_USERNAME=
API_SMTP_PASSWORD=
API_SMTP_FROM_EMAIL=
API_SMTP_FROM_NAME=HashBox

# Vault policy
FASTCDC_MIN_CHUNK_SIZE=65536
FASTCDC_AVG_CHUNK_SIZE=262144
FASTCDC_MAX_CHUNK_SIZE=1048576
STRICT_DOWNLOAD_VERIFY=true
STRICT_VERIFY_MAX_BYTES=67108864

# Optional pgAdmin tools profile
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change_me
