# ───────────────────────── OS / Editor ─────────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
*~

# ─────────────────── Environment / Secrets ─────────────────────
# Ignore all env files but keep the committed templates (*.env.example).
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example
# Common credential/secret material — never commit.
*.pem
*.key
*.p12
*.pfx
*.keystore
id_rsa
id_rsa.*
*.secret
secrets.*
credentials.json
*-credentials.json
serviceaccount*.json

# ──────────────── Node / Vite build artifacts ─────────────────
**/node_modules/
**/dist/
**/.vite/
**/coverage/
**/*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ────────────────── Go build / test artifacts ─────────────────
**/bin/
**/tmp/
**/coverage.out
**/*.test
**/*.prof
# Compiled service binaries (built locally; not source).
environment-a/api-service/api-service
environment-b/vault-core/vault-core

# ──────────────── Runtime volumes / socket outputs ────────────
data/postgres/
data/uds/
data/vault/badger/
data/vault/chunks/

# ────────────────── Playwright generated output ───────────────
# Reports, traces, screenshots and run state are regenerated on each run.
**/playwright-report/
**/test-results/
tests/blackbox/playwright/tests/test_id.tmp
tests/blackbox/playwright/.cache/

# ──────────────────── Local AI assistant state ────────────────
.claude/
.codex/
.agents/
skills-lock.json

# ───────────────────────── Misc / scratch ─────────────────────
# Extracted/derived text dumps (regenerated from source documents).
pui_extracted.txt
*.tmp
