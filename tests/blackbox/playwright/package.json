{
  "name": "hashbox-playwright-tests",
  "version": "1.0.0",
  "description": "E2E UI tests for HashBox using Playwright",
  "main": "index.js",
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "typescript": "^5.0.0"
  },
  "scripts": {
    "test": "playwright test --grep-invert \"Security Lab\"",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --grep-invert \"Security Lab\" --headed",
    "test:security-demo": "playwright test security_lab.spec.ts --headed"
  }
}
