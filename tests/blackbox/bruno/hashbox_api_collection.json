    {
      "name": "04. Upload file Identik (Deduplikasi)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 201 Created\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "var jsonData = pm.response.json();",
              "pm.test(\"Deduplikasi Berhasil (new_chunk = 0)\", function () {",
              "    pm.expect(jsonData.upload_commit_result.new_chunk_count).to.equal(0);",
              "    pm.expect(jsonData.upload_commit_result.reuse_chunk_count).to.be.above(0);",
              "    pm.expect(jsonData.upload_commit_result.dedup_ratio).to.equal(1);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
