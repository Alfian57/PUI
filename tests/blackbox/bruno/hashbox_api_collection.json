              "",
              "var jsonData = pm.response.json();",
              "pm.test(\"Deduplikasi sebagian terverifikasi\", function () {",
              "    pm.expect(jsonData.upload_commit_result.new_chunk_count).to.be.above(0);",
              "    pm.expect(jsonData.upload_commit_result.reuse_chunk_count).to.be.above(0);",
              "});"
