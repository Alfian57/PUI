# HashBox PUI - standalone API Service
# Internal identity, UDS, migration, and ownership use config defaults.

# HTTP and browser access
HTTP_ADDR=:8080
ALLOWED_ORIGIN=http://localhost:5173
TRUSTED_PROXIES=

# PostgreSQL (required)
# Format: postgres://username:password@host:port/database?sslmode=disable
# Example below: pui / change_me / localhost / 5432 / pui.
DATABASE_URL=postgres://pui:change_me@localhost:5432/pui?sslmode=disable

# API and security
MAX_UPLOAD_SIZE_BYTES=536870912
RATE_LIMIT_PER_MINUTE=120
SESSION_TTL_MINUTES=1440
SECURITY_LAB_ENABLED=false

# Password reset and SMTP
# Replace PUBLIC_WEB_URL for staging/production.
PUBLIC_WEB_URL=http://localhost:5173
PASSWORD_RESET_TTL_MINUTES=30
# SMTP is optional until password-reset email is enabled.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=HashBox
