APP_ENV=environment-a
HTTP_ADDR=:8080
ALLOWED_ORIGIN=http://localhost:5173

# Untuk local run di host, ganti host DB sesuai instance lokal Anda (mis. localhost).
DATABASE_URL=postgres://pui:change_me@localhost:5432/pui?sslmode=disable

# Untuk local run bersama vault-core, path socket default mengarah ke runtime dir yang di-ignore.
VAULT_UDS_PATH=../../data/uds/vault-core.sock

MIGRATIONS_PATH=db/migrations
MAX_UPLOAD_SIZE_BYTES=536870912
RATE_LIMIT_PER_MINUTE=120
SESSION_TTL_MINUTES=1440

# Security Lab (demo mitigasi ransomware). MATIKAN di produksi.
# Saat true, endpoint /security-lab/run melakukan upload + hapus permanen NYATA
# pada akun pemanggil untuk membuktikan invariant keamanan. Default: false.
SECURITY_LAB_ENABLED=false
SECURITY_EVENTS_UDS_PATH=../../data/uds/security-events.sock
SECURITY_EVENTS_ALLOWED_UIDS=10002

# Password reset email delivery.
PUBLIC_WEB_URL=http://localhost:5173
PASSWORD_RESET_TTL_MINUTES=30
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_FROM_NAME=HashBox
