APP_ENV=environment-a
HTTP_ADDR=:8080
ALLOWED_ORIGIN=http://localhost:5173

# Untuk local run di host, ganti host DB sesuai instance lokal Anda (mis. localhost).
DATABASE_URL=postgres://pui:change_me@localhost:5432/pui?sslmode=disable

# Untuk local run bersama vault-core, path socket default mengarah ke shared repo path.
VAULT_UDS_PATH=../../shared/uds/vault-core.sock

MIGRATIONS_PATH=db/migrations
MAX_UPLOAD_SIZE_BYTES=536870912
RATE_LIMIT_PER_MINUTE=120
SESSION_TTL_MINUTES=1440
